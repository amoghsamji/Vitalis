# Copy to .env.production and fill in from `cdk deploy` output for VitalisStack
# (NOT VitalisFrontendStack). These are baked into the static export at build
# time — `next build` must be re-run after changing them.
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
NEXT_PUBLIC_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Values from the Google-enabled Cognito deployment. The redirect URL must
# exactly match the CDK oauthRedirectUrl context value.
NEXT_PUBLIC_COGNITO_DOMAIN=vitalis-123456789012-us-east-1.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3000/login
